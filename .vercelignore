# Build output (Eleventy generates this)
_site

# Dependencies (Vercel installs these)
node_modules

# Python virtual environment
.venv

# .git se conserva: el paso de ignorar build (scripts/vercel-ignore.js) lo necesita.
.gitignore

# Temporary files
Temporales
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode
.idea
*.swp
*.swo

# Large data files that are not needed for build
Datos/
Manuales/*.pdf

# Exclude large PDFs from evaluaciones (keep only essential files)
evaluaciones/**/*.pdf

# CSV data files (not needed for build)
Datos/*.csv

# Archived API functions (not needed)
api/_archived

# Duplicate/temporary HEAD directory (anclado a la raíz: sin «/» también borraba .git/HEAD)
/HEAD

# Backup files in api directory to stay within Vercel Hobby plan limit of 12 functions
api/estudiantes.backup-2026-04-24-urgent.js
api/admin/index-FranciscoJavier.js
api/preload-sesion3.js
