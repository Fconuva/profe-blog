              <label for="dc-status-receipt" class="block text-sm font-medium text-gray-200 mb-1">Código de comprobante</label>
              <input type="text" id="dc-status-receipt" required autocomplete="off" class="w-full px-4 py-3 border border-gray-600 rounded-xl bg-gray-800 text-white placeholder-gray-400 uppercase focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" placeholder="IA-2026-XXXXXXXX">
            </div>
            <div>
              <label for="dc-status-date" class="block text-sm font-medium text-gray-200 mb-1">Cohorte</label>
              <select id="dc-status-date" required class="w-full px-4 py-3 border border-gray-600 rounded-xl bg-gray-800 text-white focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none">
                <option value="proxima-cohorte">Próxima cohorte</option>
