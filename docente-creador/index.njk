          <div class="mt-6 rounded-2xl p-4 text-sm" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1)">
            <p class="font-semibold text-white">Necesitas dos datos:</p>
            <p class="text-gray-300 mt-1">tu correo, que funciona como usuario, y el código de tu comprobante.</p>
          </div>
        </div>

        <div>
          <form id="dc-status-form" class="grid sm:grid-cols-2 gap-4" novalidate>
            <div>
              <label for="dc-status-email" class="block text-sm font-medium text-gray-200 mb-1">Usuario / correo</label>
              <input type="email" id="dc-status-email" required autocomplete="email" class="w-full px-4 py-3 border border-gray-600 rounded-xl bg-gray-800 text-white placeholder-gray-400 focus:ring-2 focus:ring-teal-400 focus:border-transparent outline-none" placeholder="tu@correo.com">
