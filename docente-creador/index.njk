        <h3 class="font-heading font-bold text-gray-900 mb-2">¿Es para alguien que recién empieza con ChatGPT?</h3>
        <p class="text-gray-600 text-sm leading-relaxed">No es el perfil ideal. El valor del taller está en docentes que ya probaron la IA y ahora buscan una capa de organización y automatización más robusta.</p>
      </div>
      <div class="bg-gray-50 rounded-2xl border border-gray-200 p-6">
        <h3 class="font-heading font-bold text-gray-900 mb-2">¿Cómo se confirma el cupo?</h3>
        <p class="text-gray-600 text-sm leading-relaxed">El cupo se considera asegurado cuando completas el pago en MercadoPago. Antes de eso, el sistema solo mantiene una reserva temporal para que termines el checkout.</p>
      </div>
      <div class="bg-gray-50 rounded-2xl border border-gray-200 p-6">
        <h3 class="font-heading font-bold text-gray-900 mb-2">¿Cómo recupero mi comprobante?</h3>
        <p class="text-gray-600 text-sm leading-relaxed">En la sección “Mi inscripción” ingresa tu correo y el código del comprobante. Allí podrás revisar el pago, imprimir tu inscripción y acceder a la clase cuando el cupo esté confirmado.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var STORAGE_KEY = 'docenteCreadorRegistration';
  var DATE_LABELS = {
    'proxima-cohorte': 'Próxima cohorte (fecha por confirmar)'
  };

  function initReveals() {
    var elements = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      elements.forEach(function(element) { element.classList.add('visible'); });
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

    elements.forEach(function(element) { observer.observe(element); });
  }

  initReveals();

  var form = document.getElementById('docente-creador-form');
  var submitBtn = document.getElementById('dc-submit');
  var errorBox = document.getElementById('dc-form-error');
  var successBox = document.getElementById('dc-success');
  var successTitle = document.getElementById('dc-success-title');
  var successMessage = document.getElementById('dc-success-message');
  var whatsappLink = document.getElementById('dc-whatsapp-link');
  var successRegistration = document.getElementById('dc-success-registration');
  var successEmail = document.getElementById('dc-success-email');
  var successSession = document.getElementById('dc-success-session');
  var successAmount = document.getElementById('dc-success-amount');
  var successStatus = document.getElementById('dc-success-status');
  var successPaymentId = document.getElementById('dc-success-payment-id');
  var successPaymentLink = document.getElementById('dc-success-payment-link');
  var successMeetLink = document.getElementById('dc-success-meet-link');
  var printSuccessButton = document.getElementById('dc-print-success');
  var statusForm = document.getElementById('dc-status-form');
  var statusSubmit = document.getElementById('dc-status-submit');
  var statusError = document.getElementById('dc-status-error');
  var statusResult = document.getElementById('dc-status-result');
  var statusResultTitle = document.getElementById('dc-status-result-title');
  var statusResultState = document.getElementById('dc-status-result-state');
  var statusResultEmail = document.getElementById('dc-status-result-email');
  var statusResultReceipt = document.getElementById('dc-status-result-receipt');
  var statusResultDate = document.getElementById('dc-status-result-date');
  var statusResultAmount = document.getElementById('dc-status-result-amount');
  var statusResultStatus = document.getElementById('dc-status-result-status');
  var statusResultPayment = document.getElementById('dc-status-result-payment');
  var statusResultMessage = document.getElementById('dc-status-result-message');
  var statusResultPay = document.getElementById('dc-status-result-pay');
  var statusResultJoin = document.getElementById('dc-status-result-join');
  var printLookupButton = document.getElementById('dc-print-lookup');

  function saveRegistration(data) {
    if (!data || (!data.registrationId && !data.id)) return;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        registrationId: data.registrationId || data.id,
        receiptNumber: data.receiptNumber || '',
        email: data.email || '',
        fecha: data.fecha || data.selectedDate || '',
        savedAt: Date.now()
      }));
    } catch (error) {
      // El comprobante también puede recuperarse manualmente en esta página.
    }
  }

  function getStoredRegistration() {
    try {
      var stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (!stored || !stored.savedAt || Date.now() - stored.savedAt > 30 * 24 * 60 * 60 * 1000) {
        localStorage.removeItem(STORAGE_KEY);
        return null;
      }
      return stored;
    } catch (error) {
      return null;
    }
  }

  function formatAmount(amount) {
    var value = Number(amount || 30000);
    try {
      return new Intl.NumberFormat('es-CL', {
        style: 'currency',
        currency: 'CLP',
        maximumFractionDigits: 0
      }).format(value) + ' CLP';
    } catch (error) {
      return '$30.000 CLP';
    }
  }

  function showActionLink(link, url, visible) {
    if (!link) return;
    if (visible && url) {
      link.href = url;
      link.classList.remove('hidden');
      return;
    }
    link.href = '#';
    link.classList.add('hidden');
  }

  function updateWhatsappLink(message) {
    if (!whatsappLink) return;
    whatsappLink.href = 'https://wa.me/56988138929?text=' + encodeURIComponent(message);
  }

  function mapStatusLabel(status) {
    if (status === 'approved') return 'Pagado / confirmado';
    if (status === 'inscrito') return 'Inscripción confirmada';
    if (status === 'pending_checkout') return 'Pendiente de pago';
    if (status === 'pending') return 'Pendiente';
    if (status === 'failure') return 'Pago rechazado';
    return status || 'Sin estado';
  }

  function setComprobanteInfo(data, fallbackDateLabel) {
    if (successRegistration) {
      successRegistration.textContent = data && (data.receiptNumber || data.id)
        ? (data.receiptNumber || data.id)
        : 'No disponible';
    }
    if (successEmail) {
      successEmail.textContent = data && data.email ? data.email : '-';
    }
    if (successSession) {
      successSession.textContent = data && data.selectedDateLabel ? data.selectedDateLabel : fallbackDateLabel;
    }
    if (successAmount) {
      successAmount.textContent = formatAmount(data && data.amount);
    }
    if (successStatus) {
      successStatus.textContent = mapStatusLabel(data && data.status);
    }
    if (successPaymentId) {
      successPaymentId.textContent = data && data.paymentId ? String(data.paymentId) : 'No disponible aún';
    }
    showActionLink(successPaymentLink, data && data.checkoutUrl, data && data.status !== 'approved');
    showActionLink(successMeetLink, data && data.meetLink, data && data.canJoin === true);
  }

  async function loadStatusByRegistration(registrationId, selectedDate, fallbackDateLabel, email, receiptNumber) {
    if (!registrationId || !selectedDate) {
      setComprobanteInfo({ email: email || '', receiptNumber: receiptNumber || '' }, fallbackDateLabel);
      return;
    }

    try {
      var response = await fetch('/api/docente-creador-estado', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          registrationId: registrationId,
          fecha: selectedDate,
          email: email || '',
          receiptNumber: receiptNumber || ''
        })
      });
      var result = await response.json();
      if (!response.ok || !result.ok || !result.found) {
        setComprobanteInfo({ id: registrationId, email: email || '', receiptNumber: receiptNumber || '' }, fallbackDateLabel);
        return;
      }
      setComprobanteInfo(result, fallbackDateLabel);
      saveRegistration(result);
    } catch (error) {
      setComprobanteInfo({ id: registrationId, email: email || '', receiptNumber: receiptNumber || '' }, fallbackDateLabel);
    }
  }

  function printReceipt(container) {
    if (!container) return;
    function cleanUp() {
      document.body.classList.remove('dc-print-mode');
      container.classList.remove('dc-print-target');
    }
    document.body.classList.add('dc-print-mode');
    container.classList.add('dc-print-target');
    window.addEventListener('afterprint', cleanUp, { once: true });
    window.print();
    window.setTimeout(cleanUp, 1000);
  }

  function renderLookupResult(result) {
    var label = mapStatusLabel(result.status);
    statusResultTitle.textContent = result.nombre ? 'Inscripción de ' + result.nombre : 'Inscripción encontrada';
    statusResultEmail.textContent = result.email || '-';
    statusResultReceipt.textContent = result.receiptNumber || result.id || '-';
    statusResultDate.textContent = result.selectedDateLabel || DATE_LABELS[result.selectedDate] || '-';
    statusResultAmount.textContent = formatAmount(result.amount);
    statusResultStatus.textContent = label;
    statusResultPayment.textContent = result.paymentId ? String(result.paymentId) : 'Aún no disponible';
    statusResultMessage.textContent = result.message || 'La inscripción fue encontrada.';
    statusResultState.textContent = label;
    statusResultState.className = result.status === 'approved'
      ? 'inline-flex self-start px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800'
      : 'inline-flex self-start px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
    showActionLink(statusResultPay, result.checkoutUrl, result.status === 'pending_checkout' && result.holdActive === true);
    showActionLink(statusResultJoin, result.meetLink, result.canJoin === true);
    statusResult.classList.remove('hidden');
  }

  async function handleReturnState() {
    var params = new URLSearchParams(window.location.search);
    var payment = params.get('payment');
    var date = params.get('date');
    var registration = params.get('registration');
    var dateLabel = DATE_LABELS[date] || 'la fecha seleccionada';
    var stored = getStoredRegistration();
    var storedMatches = stored && (!registration || stored.registrationId === registration);
    var email = storedMatches ? stored.email : '';
    var receiptNumber = storedMatches ? stored.receiptNumber : '';

    if (!payment) return;

    if (payment === 'success' || payment === 'pending') {
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
      if (payment === 'success') {
        successTitle.textContent = 'Pago recibido';
        successMessage.textContent = 'Tu pago fue enviado correctamente para ' + dateLabel + '. Si no ves confirmación por correo en unos minutos, escríbenos por WhatsApp.';
        updateWhatsappLink('Hola, ya pagué mi inscripción del curso IA y Agentes para la Educación para ' + dateLabel + '.');
      } else {
        successTitle.textContent = 'Pago pendiente';
        successMessage.textContent = 'MercadoPago dejó tu pago en estado pendiente para ' + dateLabel + '. Te recomendamos revisar tu correo o escribirnos para seguimiento.';
        updateWhatsappLink('Hola, mi pago del curso IA y Agentes para la Educación para ' + dateLabel + ' quedó pendiente y necesito seguimiento.');
      }
      await loadStatusByRegistration(registration, date, dateLabel, email, receiptNumber);
      successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    if (payment === 'failure') {
      errorBox.textContent = 'El pago no se completó. Puedes volver a intentarlo con la misma fecha o escribirnos por WhatsApp si necesitas ayuda.';
      errorBox.classList.remove('hidden');
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  var storedRegistration = getStoredRegistration();
  if (storedRegistration && statusForm) {
    document.getElementById('dc-status-email').value = storedRegistration.email || '';
    document.getElementById('dc-status-receipt').value = storedRegistration.receiptNumber || '';
    document.getElementById('dc-status-date').value = storedRegistration.fecha || '';
  }

  if (printSuccessButton) {
    printSuccessButton.addEventListener('click', function() { printReceipt(successBox); });
  }

  if (printLookupButton) {
    printLookupButton.addEventListener('click', function() { printReceipt(statusResult); });
  }

  if (statusForm) {
    statusForm.addEventListener('submit', async function(event) {
      event.preventDefault();
      var email = document.getElementById('dc-status-email').value.trim().toLowerCase();
      var receiptNumber = document.getElementById('dc-status-receipt').value.trim().toUpperCase();
      var fecha = document.getElementById('dc-status-date').value;

      statusError.classList.add('hidden');
      statusResult.classList.add('hidden');

      if (!email || !receiptNumber || !fecha) {
        statusError.textContent = 'Ingresa tu correo, el código del comprobante y la cohorte.';
        statusError.classList.remove('hidden');
        return;
      }

      statusSubmit.disabled = true;
      statusSubmit.textContent = 'Consultando...';

      try {
        var response = await fetch('/api/docente-creador-estado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, receiptNumber: receiptNumber, fecha: fecha })
        });
        var result = await response.json();
        if (!response.ok || !result.ok) {
          throw new Error(result.error || 'No pudimos consultar la inscripción.');
        }
        if (!result.found) {
          throw new Error(result.message || 'No encontramos una inscripción con esos datos.');
        }
        renderLookupResult(result);
        saveRegistration(result);
      } catch (error) {
        statusError.textContent = error.message || 'No pudimos consultar la inscripción.';
        statusError.classList.remove('hidden');
      } finally {
        statusSubmit.disabled = false;
        statusSubmit.textContent = 'Consultar inscripción';
      }
    });
  }

  if (!form) return;

  handleReturnState();

  form.addEventListener('submit', async function(event) {
    event.preventDefault();

    errorBox.classList.add('hidden');
    errorBox.textContent = '';

    var payload = {
      fecha: document.getElementById('dc-fecha').value,
      nombre: document.getElementById('dc-nombre').value.trim(),
      email: document.getElementById('dc-email').value.trim(),
      telefono: document.getElementById('dc-telefono').value.trim(),
      rol: document.getElementById('dc-rol').value,
      establecimiento: document.getElementById('dc-establecimiento').value.trim(),
      experienciaIa: document.getElementById('dc-nivel-ia').value,
      objetivo: document.getElementById('dc-objetivo').value.trim(),
      region: document.getElementById('dc-region').value.trim(),
      comuna: document.getElementById('dc-comuna').value.trim(),
      nivelEducativo: document.getElementById('dc-nivel-educativo').value,
      asignatura: document.getElementById('dc-asignatura').value.trim(),
      tipoEstablecimiento: document.getElementById('dc-tipo-establecimiento').value,
      aniosDocencia: document.getElementById('dc-anios-docencia').value,
      website: document.getElementById('dc-website').value.trim(),
      consent: document.getElementById('dc-consent').checked
    };

    if (!payload.consent) {
      errorBox.textContent = 'Debes aceptar el contacto para continuar con la reserva.';
      errorBox.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creando inscripción...';

    try {
      var response = await fetch('/api/docente-creador-inscripcion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      var result = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(result.error || 'No se pudo registrar la reserva. Intenta nuevamente.');
      }

      if (!result.checkoutUrl) {
        throw new Error('No se pudo generar el enlace de pago. Intenta nuevamente.');
      }

      saveRegistration({
        registrationId: result.id,
        receiptNumber: result.receiptNumber,
        email: payload.email,
        fecha: payload.fecha
      });

      var selectedDateLabel = result.selectedDateLabel || DATE_LABELS[payload.fecha] || 'Fecha seleccionada';
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
      successTitle.textContent = 'Inscripción creada';
      successMessage.textContent = 'Tu usuario y comprobante ya están listos. Guárdalos y continúa al pago de $30.000 para confirmar el cupo.';
      setComprobanteInfo({
        id: result.id,
        receiptNumber: result.receiptNumber,
        email: payload.email,
        selectedDateLabel: selectedDateLabel,
        amount: 30000,
        status: 'pending_checkout',
        checkoutUrl: result.checkoutUrl
      }, selectedDateLabel);
      updateWhatsappLink('Hola, generé mi inscripción para el curso IA y Agentes para la Educación. Mi comprobante es ' + result.receiptNumber + '.');
      successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (error) {
      errorBox.textContent = error.message || 'No se pudo registrar la reserva.';
      errorBox.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Registrarme y obtener comprobante';
      return;
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Registrarme y obtener comprobante';
  });
})();
</script>
