            <div class="grid sm:grid-cols-2 gap-3 text-sm">
              <p><span class="font-semibold">Usuario:</span><br><span id="dc-status-result-email">-</span></p>
              <p><span class="font-semibold">Comprobante:</span><br><span id="dc-status-result-receipt">-</span></p>
              <p><span class="font-semibold">Clase:</span><br><span id="dc-status-result-date">-</span></p>
              <p><span class="font-semibold">Valor:</span><br><span id="dc-status-result-amount">$30.000 CLP</span></p>
              <p><span class="font-semibold">Estado:</span><br><span id="dc-status-result-status">-</span></p>
              <p><span class="font-semibold">Operación MercadoPago:</span><br><span id="dc-status-result-payment">-</span></p>
            </div>
            <p id="dc-status-result-message" class="mt-5 p-4 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-700"></p>
            <div class="dc-no-print flex flex-col sm:flex-row flex-wrap gap-3 mt-4">
              <a id="dc-status-result-pay" href="#" class="hidden inline-flex items-center justify-center px-5 py-3 bg-primary-600 text-white font-semibold rounded-xl hover:bg-primary-700 transition-colors">Completar pago</a>
              <a id="dc-status-result-join" href="#" target="_blank" rel="noopener" class="hidden inline-flex items-center justify-center px-5 py-3 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors">Entrar a la clase</a>
              <button type="button" id="dc-print-lookup" class="inline-flex items-center justify-center px-5 py-3 bg-gray-100 text-gray-800 font-semibold rounded-xl hover:bg-gray-200 transition-colors">Imprimir comprobante</button>
            </div>
