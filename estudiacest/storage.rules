rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /anuario_2026/4dtp/{rut}/{category}/{fileId}/{fileName} {
      function isOwner() {
        return request.auth != null
          && request.auth.token.anuario4dtp == true
          && request.auth.uid == 'anuario_' + rut;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner()
        && request.auth.token.uploadFileId == fileId
        && request.auth.token.uploadCategory == category
        && request.auth.token.uploadFileName == fileName
        && request.resource.size > 0
        && request.resource.size <= request.auth.token.uploadMaxBytes
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.metadata.ownerRut == rut
        && request.resource.metadata.category == category
        && request.resource.metadata.fileId == fileId;
      allow update: if false;
    }

    match /interrogaciones_2026/{instrumento}/{docente}/{alumnoId}/{intentoId}/{posicion}/{fileId}/{fileName} {
      function canUploadInterrogationAudio() {
        return request.auth != null
          && request.auth.token.interrogacionAudio == true
          && request.auth.token.instrumento == instrumento
          && request.auth.token.docente == docente
          && request.auth.token.alumnoId == alumnoId
          && request.auth.token.intentoId == intentoId
          && request.auth.token.posicion == posicion
          && request.auth.token.fileId == fileId
          && request.auth.token.fileName == fileName;
      }

      allow create: if canUploadInterrogationAudio()
        && request.resource.size >= 1500
        && request.resource.size <= request.auth.token.uploadMaxBytes
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*')
        && request.resource.metadata.instrumento == instrumento
        && request.resource.metadata.docente == docente
        && request.resource.metadata.alumnoId == alumnoId
        && request.resource.metadata.intentoId == intentoId
        && request.resource.metadata.posicion == posicion
        && request.resource.metadata.fileId == fileId;
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
