                </marker>
              </defs>
              <rect x="2" y="2" width="596" height="296" rx="14" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5"/>
              <text x="300" y="30" fill="#0f172a" font-size="16.5" font-weight="700" text-anchor="middle">El ciclo de evaluación con ingreso y egreso</text>

              <!-- ingreso -->
              <rect x="26" y="60" width="160" height="58" rx="12" fill="#475569" stroke="#334155" stroke-width="2"/>
              <text x="106" y="84" fill="#ffffff" font-size="12" font-weight="700" text-anchor="middle">Ingreso</text>
              <text x="106" y="102" fill="#e2e8f0" font-size="10" text-anchor="middle">en cualquier momento</text>

              <!-- diagnóstica -->
              <rect x="220" y="60" width="160" height="58" rx="12" fill="#e2e8f0" stroke="#475569" stroke-width="2"/>
              <text x="300" y="84" fill="#334155" font-size="12" font-weight="700" text-anchor="middle">Diagnóstica</text>
              <text x="300" y="102" fill="#334155" font-size="10" text-anchor="middle">breve, en la primera clase</text>

              <!-- formativa -->
