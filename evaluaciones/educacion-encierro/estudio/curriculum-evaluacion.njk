              <text x="494" y="84" fill="#334155" font-size="12" font-weight="700" text-anchor="middle">Formativa continua</text>
              <text x="494" y="102" fill="#334155" font-size="10" text-anchor="middle">pauta simple, clase a clase</text>

              <!-- evidencia -->
              <rect x="414" y="176" width="160" height="58" rx="12" fill="#e2e8f0" stroke="#475569" stroke-width="2"/>
              <text x="494" y="200" fill="#334155" font-size="12" font-weight="700" text-anchor="middle">Evidencia acumulable</text>
              <text x="494" y="218" fill="#334155" font-size="10" text-anchor="middle">carpeta con fecha y pauta</text>

              <!-- traslado / egreso -->
              <rect x="220" y="176" width="160" height="58" rx="12" fill="#475569" stroke="#334155" stroke-width="2"/>
              <text x="300" y="200" fill="#ffffff" font-size="12" font-weight="700" text-anchor="middle">Traslado o egreso</text>
              <text x="300" y="218" fill="#e2e8f0" font-size="10" text-anchor="middle">la evidencia viaja con él</text>

              <path d="M186 89 L216 89" fill="none" stroke="#475569" stroke-width="2.6" marker-end="url(#arrEva)"/>
              <path d="M380 89 L410 89" fill="none" stroke="#475569" stroke-width="2.6" marker-end="url(#arrEva)"/>
