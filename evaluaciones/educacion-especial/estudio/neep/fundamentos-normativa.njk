              <text x="412" y="147" fill="#5b21b6" font-size="11.5" font-weight="700" text-anchor="middle">persona</text>
              <rect x="468" y="118" width="84" height="48" rx="8" fill="#fff" stroke="#7c3aed" stroke-width="2"/>
              <text x="510" y="139" fill="#5b21b6" font-size="11.5" font-weight="700" text-anchor="middle">entorno</text>
              <text x="510" y="155" fill="#5b21b6" font-size="11.5" font-weight="700" text-anchor="middle">(barreras)</text>
