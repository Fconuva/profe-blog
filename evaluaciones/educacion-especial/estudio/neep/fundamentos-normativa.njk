              <text x="148" y="143" fill="#5b21b6" font-size="13" font-weight="700" text-anchor="middle">el "problema"</text>
              <text x="148" y="196" fill="#334155" font-size="12.5" text-anchor="middle">El defecto está dentro</text>
              <text x="148" y="214" fill="#334155" font-size="12.5" text-anchor="middle">de la persona: hay que</text>
              <text x="148" y="232" fill="#334155" font-size="12.5" text-anchor="middle">"corregirla"</text>
              <path d="M278 145 h44" fill="none" stroke="#7c3aed" stroke-width="3" stroke-linecap="round" marker-end="url(#arrM1)"/>
