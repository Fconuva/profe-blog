              <text x="120" y="251" text-anchor="middle" font-size="12" fill="#065f46">Materia prima</text>
              <path d="M344,180 C400,186 440,204 452,224" fill="none" stroke="#047857" stroke-width="2.2" marker-end="url(#ecc-ve)"/>
              <path d="M430,266 C405,282 380,289 364,291" fill="none" stroke="#047857" stroke-width="2.2" marker-end="url(#ecc-ve)"/>
