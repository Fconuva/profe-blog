              <line x1="243" y1="176" x2="180" y2="140" stroke="#b91c1c" stroke-width="1.8"/>
              <line x1="357" y1="176" x2="420" y2="140" stroke="#b91c1c" stroke-width="1.8"/>
              <line x1="243" y1="255" x2="180" y2="300" stroke="#b91c1c" stroke-width="1.8"/>
