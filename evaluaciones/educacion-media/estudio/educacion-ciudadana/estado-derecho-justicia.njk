              <text x="247" y="192" text-anchor="middle" font-size="10.5" fill="#991b1b">la misma norma</text>
              <text x="247" y="206" text-anchor="middle" font-size="10.5" fill="#991b1b">para todos,</text>
              <text x="247" y="220" text-anchor="middle" font-size="10.5" fill="#991b1b">gobernantes</text>
              <text x="247" y="234" text-anchor="middle" font-size="10.5" fill="#991b1b">incluidos</text>
