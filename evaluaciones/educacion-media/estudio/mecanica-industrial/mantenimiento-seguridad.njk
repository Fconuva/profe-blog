              <text x="313" y="163" text-anchor="middle" font-size="9" font-weight="700" fill="#44403c">reposo:</text>
              <text x="313" y="176" text-anchor="middle" font-size="9" fill="#44403c">escape</text>
              <text x="347" y="163" text-anchor="middle" font-size="9" font-weight="700" fill="#44403c">activada:</text>
