                <rect x="198" y="56" width="164" height="52" rx="9" fill="#fde68a" stroke="#a16207" stroke-width="1.5"/>
                <text x="280" y="76" text-anchor="middle" font-size="11" font-weight="800" fill="#854d0e">DESTINO UNIVERSAL</text>
