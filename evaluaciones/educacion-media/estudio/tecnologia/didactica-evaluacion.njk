                <path d="M668 209 C672 235, 672 240, 668 242" fill="none" stroke="#475569" stroke-width="2.5" marker-end="url(#cicloTecAr)"/>
                <path d="M624 318 C580 335, 530 342, 480 332" fill="none" stroke="#475569" stroke-width="2.5" marker-end="url(#cicloTecAr)"/>
