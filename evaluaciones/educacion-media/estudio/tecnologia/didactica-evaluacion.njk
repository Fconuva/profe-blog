                <!-- node 3 bottom-right -->
                <circle cx="660" cy="290" r="49" fill="#e2e8f0" stroke="#475569" stroke-width="2"/>
                <text x="660" y="285" text-anchor="middle" font-size="12" font-weight="800" fill="#334155">3. PLANIFICAR</text>
                <text x="660" y="303" text-anchor="middle" font-size="10.5" fill="#475569">pasos y materiales</text>
                <!-- node 4 bottom -->
                <circle cx="430" cy="335" r="49" fill="#e2e8f0" stroke="#475569" stroke-width="2"/>
                <text x="430" y="330" text-anchor="middle" font-size="12" font-weight="800" fill="#334155">4. CREAR</text>
                <text x="430" y="348" text-anchor="middle" font-size="10.5" fill="#475569">el prototipo</text>
                <!-- node 5 bottom-left (destacada) -->
