                <text x="430" y="118" text-anchor="middle" font-size="10.5" fill="#475569">problema o necesidad</text>
                <!-- node 2 top-right -->
                <circle cx="660" cy="160" r="49" fill="#e2e8f0" stroke="#475569" stroke-width="2"/>
