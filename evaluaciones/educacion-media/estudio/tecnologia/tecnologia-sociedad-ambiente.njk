                <line x1="284" y1="112" x2="310" y2="112" stroke="#475569" stroke-width="2.5" marker-end="url(#ecAr)"/>
                <line x1="420" y1="112" x2="452" y2="112" stroke="#475569" stroke-width="2.5" marker-end="url(#ecAr)"/>
                <rect x="454" y="86" width="120" height="52" rx="10" fill="#334155"/>
                <text x="514" y="117" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">RESIDUO</text>

                <text x="430" y="196" text-anchor="middle" font-size="14" font-weight="800" fill="#334155">CIRCULAR: los materiales vuelven al ciclo</text>
                <circle cx="430" cy="252" r="46" fill="none" stroke="#475569" stroke-width="12" stroke-dasharray="150 100" stroke-linecap="round"/>
                <path d="M430 206 l-9 -13 l18 0 z" fill="#475569"/>
                <text x="430" y="248" text-anchor="middle" font-size="12" font-weight="700" fill="#334155">reducir</text>
                <text x="430" y="266" text-anchor="middle" font-size="12" font-weight="700" fill="#334155">reutilizar</text>
                <rect x="150" y="228" width="180" height="48" rx="10" fill="#e2e8f0" stroke="#475569" stroke-width="1.6"/>
