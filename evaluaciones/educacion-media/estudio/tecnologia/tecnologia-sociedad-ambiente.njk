              <g font-family="Inter,system-ui,sans-serif">
                <text x="230" y="68" text-anchor="middle" font-size="14" font-weight="800" fill="#334155">LINEAL: extraer, usar, tirar</text>
                <rect x="40"  y="86" width="108" height="52" rx="10" fill="#e2e8f0" stroke="#475569" stroke-width="1.6"/>
                <text x="94" y="117" text-anchor="middle" font-size="12" fill="#334155">extraer</text>
                <rect x="176" y="86" width="108" height="52" rx="10" fill="#e2e8f0" stroke="#475569" stroke-width="1.6"/>
                <text x="230" y="117" text-anchor="middle" font-size="12" fill="#334155">producir</text>
