                <text x="594" y="173" text-anchor="middle" font-size="11.5" fill="#0f172a">energía</text>

                <rect x="696" y="96" width="140" height="96" rx="12" fill="#334155"/>
                <text x="766" y="132" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">DESECHO</text>
