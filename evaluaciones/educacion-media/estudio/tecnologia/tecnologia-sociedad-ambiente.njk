                <text x="266" y="173" text-anchor="middle" font-size="11.5" fill="#0f172a">residuos de fábrica</text>

                <rect x="368" y="96" width="124" height="96" rx="12" fill="#e2e8f0" stroke="#475569" stroke-width="2"/>
