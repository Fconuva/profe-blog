                <text x="766" y="173" text-anchor="middle" font-size="11.5" fill="#e2e8f0">reciclaje</text>

                <line x1="164" y1="144" x2="194" y2="144" stroke="#475569" stroke-width="3" marker-end="url(#clAr)"/>
